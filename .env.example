DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/dbname
# Auth: generate a random secret with secrets.token_urlsafe(48); never commit the real value.
AUTH_JWT_SECRET=
AUTH_ORIGIN=http://127.0.0.1:8000
# false is permitted only for local HTTP development; production HTTPS must use true.
AUTH_COOKIE_SECURE=false
